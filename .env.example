# BugFlow Frontend - Environment Variables Template
# Copy this file to .env and adjust variables as needed.
REACT_APP_API_BASE_URL=http://localhost:8081
REACT_APP_AUTH0_DOMAIN=your_auth0_domain.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your_auth0_client_id
REACT_APP_AUTH0_AUDIENCE=https://bugflow-api
